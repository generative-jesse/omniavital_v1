  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://lsladukwqwpwdxcnbvea.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "vitality-gateway",
      "version": "0.2.0",
      "title": "Vitality Gateway"
    },
    "tools": [
      {
        "name": "list_products",
        "title": "List products",
        "description": "List the OmniaVital ritual products with pricing, category and tagline.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "Optional category filter, e.g. morning, focus or evening."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product",
        "description": "Get full detail for one OmniaVital product by its slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Product slug, e.g. morning-protocol."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Get the signed-in member's OmniaVital profile (name, OV tag).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_purchases",
        "title": "List my purchases",
        "description": "List the signed-in member's OmniaVital orders with product names and totals.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "log_ritual",
        "title": "Log a ritual",
        "description": "Record a completed (or skipped) ritual for the signed-in member on a given date.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "product_slug": {
              "type": "string",
              "minLength": 1,
              "description": "Slug of the ritual product, e.g. morning-protocol."
            },
            "logged_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date in YYYY-MM-DD. Defaults to today."
            },
            "completed": {
              "type": "boolean",
              "default": true,
              "description": "Whether the ritual was completed."
            },
            "notes": {
              "type": "string",
              "maxLength": 500,
              "description": "Optional note about the ritual."
            }
          },
          "required": [
            "product_slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_ritual_streak",
        "title": "Get my ritual streak",
        "description": "Get the signed-in member's current daily ritual streak, ring status and today's progress.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "log_diet",
        "title": "Log food / diet",
        "description": "Log what the member ate. Take their messy, natural description of a meal, extract the individual food items, and estimate calories and macros before calling this. Always pass the member's original wording in raw_text.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "raw_text": {
              "type": "string",
              "description": "The member's original description of what they ate."
            },
            "meal": {
              "type": "string",
              "description": "breakfast, lunch, dinner, snack or other. Infer from context or time."
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Food item, e.g. 'grilled chicken breast'."
                  },
                  "quantity": {
                    "type": "string",
                    "description": "Portion, e.g. '6 oz' or '1 cup'."
                  },
                  "calories": {
                    "type": "number"
                  },
                  "protein_g": {
                    "type": "number"
                  },
                  "carbs_g": {
                    "type": "number"
                  },
                  "fat_g": {
                    "type": "number"
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              },
              "description": "Cleaned, itemised breakdown of the meal with per-item estimates."
            },
            "calories": {
              "type": "number",
              "description": "Total estimated calories for the meal."
            },
            "protein_g": {
              "type": "number",
              "description": "Total estimated protein in grams."
            },
            "carbs_g": {
              "type": "number",
              "description": "Total estimated carbohydrates in grams."
            },
            "fat_g": {
              "type": "number",
              "description": "Total estimated fat in grams."
            },
            "logged_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date in YYYY-MM-DD. Defaults to today."
            }
          },
          "required": [
            "raw_text"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "log_mood",
        "title": "Log mood",
        "description": "Log how the member is feeling. Summarise their message into a short mood label, estimate a 1-10 score and energy level, pull out a few tags, and keep their original words in raw_text.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mood": {
              "type": "string",
              "description": "Short mood label, e.g. 'focused', 'anxious', 'calm'."
            },
            "raw_text": {
              "type": "string",
              "description": "The member's original words."
            },
            "score": {
              "type": "number",
              "description": "Overall mood 1 (worst) to 10 (best)."
            },
            "energy": {
              "type": "number",
              "description": "Energy level 1 (depleted) to 10 (peak)."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Short themes, e.g. ['work stress','poor sleep']."
            },
            "logged_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date in YYYY-MM-DD. Defaults to today."
            }
          },
          "required": [
            "mood"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_journal_entry",
        "title": "Add journal entry",
        "description": "Save a dated journal entry for the signed-in member. Use for reflections, wins, symptoms or anything they want written down.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "description": "The journal entry text, in the member's voice."
            },
            "title": {
              "type": "string",
              "description": "Short title for the entry."
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Short themes for the entry."
            },
            "logged_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date in YYYY-MM-DD. Defaults to today."
            }
          },
          "required": [
            "body"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_daily_log",
        "title": "Get a day's health log",
        "description": "Read everything the signed-in member has logged for a date or date range: rituals taken, meals with nutrition, moods and journal entries. Call this before prompting them, so you only ask for what is missing.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "start_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Start date YYYY-MM-DD. Defaults to today."
            },
            "end_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "End date YYYY-MM-DD. Defaults to start_date."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "set_checkin_reminder",
        "title": "Schedule a check-in",
        "description": "Schedule a check-in so the member is prompted to capture their diet, mood and rituals later. Offer this at the end of a logging conversation. The reminder appears on their dashboard.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "remind_at": {
              "type": "string",
              "description": "When to check in, as an ISO 8601 timestamp, e.g. 2026-09-15T18:00:00Z."
            },
            "kind": {
              "type": "string",
              "description": "daily, diet, mood, ritual or once."
            },
            "message": {
              "type": "string",
              "description": "What to ask the member when checking in."
            }
          },
          "required": [
            "remind_at"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_community_posts",
        "title": "List community posts",
        "description": "List recent discussion threads in The Collective community forum.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "Optional category filter."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum threads to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_community_post",
        "title": "Create community post",
        "description": "Post a new thread, or a reply, in The Collective community forum as the signed-in member.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "description": "Thread title."
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "description": "Post body."
            },
            "category": {
              "type": "string",
              "default": "general",
              "description": "Forum category."
            },
            "parent_id": {
              "type": "string",
              "format": "uuid",
              "description": "Thread id when replying to an existing thread."
            }
          },
          "required": [
            "title",
            "body"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
